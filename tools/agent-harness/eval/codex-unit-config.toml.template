model = "gpt-6-astra"
model_reasoning_effort = "high"
approval_policy = "never"
allow_login_shell = false
default_permissions = "eval"
web_search = "disabled"
project_doc_max_bytes = 32768
[features]
network_proxy = true
apps = false
plugins = false
hooks = false
plugin_hooks = false
browser_use = false
